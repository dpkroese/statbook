file = as.matrix(read.csv("USCPI.csv"));#
file = matrix(file[,1]);                #
file = matrix(file[-258]);              #
d = 5.673853997; #The first line        #
USCPI = matrix(rbind(d,file),,1);       #
#########################################
y0 = USCPI[1];
y = matrix(USCPI[2:nrow(USCPI)]);
T = length(y);
X = cbind(matrix(rep(1,T)),rbind(y0,matrix(y[1:(nrow(y)-1)])));
f<-function(psi){
res<-loglike_ARMA11(psi,X,y);
return (-res);
}
psi=-0.2774
T = length(y);
####<Making a sparse matrix>####
Sp=diag(T);                    #
d=matrix(rep(0,T),1);          #
sparse=rbind(d,Sp);            #
sparse<-sparse[-(T+1),]        #
################################
H = diag(T) + psi*sparse;
HH = H  %*% t(H);
rhohat = solve((t(X) %*% solve(HH,X)),(t(X) %*% solve(HH,y)));
rhohat
uhat = y-X %*% rhohat;
sig2hat = t(uhat) %*% solve(HH,uhat)/T;
sig2hat
sig2hat = (t(uhat) %*% solve(HH,uhat)/T)[1];
(HH\uhat)
solve(HH,uhat)
l = -T/2*log(2*pi*sig2hat) - .5/sig2hat*t(uhat) %*% solve(HH,uhat);
l
